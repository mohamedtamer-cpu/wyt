# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/wyt
# Gmail account and Google App Password (not your normal login password)
GMAIL_USER=your-team@gmail.com
GMAIL_PASS=your-google-app-password
# Optional comma-separated override. Defaults to config/notifications.json.
ADMIN_NOTIFICATION_EMAILS=
ADMIN_PASSWORD=choose-a-strong-admin-password
PORT=3000
NODE_ENV=development
